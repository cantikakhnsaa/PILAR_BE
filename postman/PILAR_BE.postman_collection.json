              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Data berupa array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
                ]
              }
