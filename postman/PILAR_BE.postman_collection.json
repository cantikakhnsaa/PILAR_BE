          ]
        },
        {
          "name": "Daftar role",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/roless?pagination[page]=1&pagination[pageSize]=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
